# Modo Docker local · NO lo copies a mano: scripts/docker-local.sh genera env/local/progreso.env
# a partir de consultaya-deploy/.env (usuario, contraseña, puerto y JWT_SECRET).
# Los valores de abajo son marcadores; el host real es host.docker.internal (tu PostgreSQL).
DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@host.docker.internal:5432/consultaya_progreso
JWT_SECRET=dev-secret-cambiar
LECCIONES_URL=http://lecciones:8000
ESTRUCTURA_CACHE_SEG=60
LOG_LEVEL=INFO
