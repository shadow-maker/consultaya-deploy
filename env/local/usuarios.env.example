# Modo Docker local · NO lo copies a mano: scripts/docker-local.sh genera env/local/usuarios.env
# a partir de consultaya-deploy/.env (usuario, contraseña, puerto y JWT_SECRET).
# Los valores de abajo son marcadores; el host real es host.docker.internal (tu PostgreSQL).
DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@host.docker.internal:5432/consultaya_usuarios
JWT_SECRET=dev-secret-cambiar
JWT_EXP_HORAS=24
LOG_LEVEL=INFO
