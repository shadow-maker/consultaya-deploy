# ConsultaYa · configuración local de desarrollo (fuente única).
# Copia este archivo a ".env" (que Git ignora) y ajusta tus datos:
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
# Los scripts (dev-up, db-local-init, docker-local) generan a partir de aquí los .env
# de los 3 microservicios y los de Docker. No hace falta editar nada más.

# Servidor PostgreSQL de tu máquina (donde se crean las bases consultaya_*).
DB_HOST=localhost
DB_PORT=5432

# Usuario con permiso para crear bases y su contraseña.
#   - Postgres.app (macOS): suele ser tu usuario del sistema y no tiene contraseña.
#   - Instalador de PostgreSQL (Windows/Linux): normalmente "postgres" con la contraseña
#     que elegiste al instalar.
# Déjala vacía si tu usuario no usa contraseña. Si tiene caracteres especiales, no hace
# falta escaparlos: los scripts los codifican en las URLs.
DB_USER=postgres
DB_PASSWORD=

# Secreto con el que usuarios firma los JWT y lecciones/progreso los validan.
# Es el mismo para los 3 servicios. Este valor es solo de desarrollo; en AWS se usa otro.
JWT_SECRET=dev-secret-cambiar
